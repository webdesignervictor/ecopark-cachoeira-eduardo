# Endereço público do site, sem barra no final. Usado nas tags de SEO/compartilhamento,
# no sitemap e no robots.txt. Preencha quando o domínio existir (ou defina no Vercel).
# Ex.: VITE_SITE_URL=https://evento.cachoeiradoesmeril.com.br
VITE_SITE_URL=

# Pagamento online pelo Mercado Pago no Monte seu pack. 1 = mostra "Pagar agora".
# Só ligar depois de configurar no Vercel: MP_ACCESS_TOKEN, DATABASE_URL_RESERVAS (e MP_WEBHOOK_SECRET).
VITE_PAGAMENTO_ATIVO=0
